{
  "expo": {
    "name": "KarmaLock",
    "slug": "KarmaLock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "karmalock",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.KarmaLock",
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": ["NDEF", "TAG"]
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "KarmaLock uses the local network to reach your development API on this Wi‑Fi.",
        "NFCReaderUsageDescription": "KarmaLock uses NFC to scan and register your chips to belongings.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "KarmaLock uses Face ID to unlock the app after you sign in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
